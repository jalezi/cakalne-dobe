{
  "name": "cakalne-dobe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:safe": "rm -rf .next && next dev --turbopack",
    "prebuild": "pnpm run lint",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check --write",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "prepare": "lefthook install",
    "drizzle:local:push": "drizzle-kit push --config=./drizzle/config/local.ts",
    "drizzle:prod:push": "drizzle-kit push --config=./drizzle/config/prod.ts",
    "drizzle:local:studio": "drizzle-kit studio --config=./drizzle/config/local.ts --port 4000",
    "drizzle:prod:studio": "drizzle-kit studio --config=./drizzle/config/prod.ts --port 4001",
    "db:local:seed": "node --env-file=.env.development.local -r esbuild-register seed/seed-db.ts",
    "db:prod:seed": "node --env-file=.env.production.local -r esbuild-register seed/seed-db.ts",
    "db:local:ensure-fresh-data": "node --env-file=.env.development.local -r esbuild-register seed/ensure-fresh-data.ts",
    "db:prod:ensure-fresh-data": "node --env-file=.env.production.local -r esbuild-register seed/ensure-fresh-data.ts",
    "db:local:update-job-dates": "node --env-file=.env.development.local -r esbuild-register seed/update-date-from-now-desc.ts",
    "fetch:jobs": "node -r esbuild-register scripts/fetch-jobs.ts",
    "vercel:cleanup:prod": "node -r esbuild-register scripts/cleanup-vercel-prod.ts",
    "turso:dev": "turso dev",
    "turso:dev:file": "turso dev --db-file dev.db",
    "turso:prod:file": "turso dev --db-file prod.db",
    "fallow": "fallow dead-code",
    "fallow:fix": "fallow fix",
    "fallow:health:baseline": "pnpm test:coverage && fallow health --coverage coverage/coverage-final.json --save-baseline fallow-health-baseline.json --baseline-mode identity --complexity --report-only && biome check --write fallow-health-baseline.json",
    "issue:history": "bash scripts/issue-history.sh",
    "worktree:new": "bash scripts/worktree.sh new",
    "worktree:agent": "bash scripts/worktree.sh agent",
    "worktree:remove": "bash scripts/worktree.sh remove",
    "worktree:wait": "bash scripts/worktree.sh wait"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@libsql/client": "^0.18.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "graphql": "^16.13.2",
    "graphql-request": "^7.4.0",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "^0.31.11",
    "esbuild-register": "^3.6.0",
    "fallow": "^3.37.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
